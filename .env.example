# Set these in Netlify > Site configuration > Environment variables (never commit a real .env).
SESSION_SECRET=                # REQUIRED: random string, 32+ characters
ADMIN_PASSWORD=                # REQUIRED on first run: 8+ characters. Creates the first admin.
ADMIN_USERNAME=admin           # optional
SEED_SHOP=1                    # optional: load the starter milk/eggs/chicken/flour/oil products on first run
APP_TIMEZONE=Africa/Nairobi    # optional
SESSION_HOURS=12               # optional: idle time before a till signs out

# Only if you do NOT use Netlify Database: any external PostgreSQL (Neon, Supabase...)
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
